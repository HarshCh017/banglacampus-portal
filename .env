# =====================================================================
# BengalCampus Environment Variables Specification
# =====================================================================
# Configure these in your local .env.local and in your Vercel Project Settings
# under Settings -> Environment Variables.

# 1. Base Site URL (For Vercel production: https://your-project.vercel.app or custom domain)
NEXT_PUBLIC_SITE_URL=https://bengalcampus.in

# 2. Authentication Secret (Generate a strong 32-byte secret using: openssl rand -base64 32)
AUTH_SECRET=replace_with_openssl_rand_base64_32_secret

# 3. Google OAuth 2.0 Credentials (From Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Google Sheets Integration Webhook (Google Apps Script Web App Deployment URL)
# Refer to GOOGLE_SHEETS_SETUP.md for complete 5-minute setup instructions
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# 5. Enquiry Alert Notification Email (Recipient for new student leads)
ENQUIRY_NOTIFICATION_EMAIL=admissions@bengalcampus.in

# 6. Optional Email Delivery Service (e.g. Resend for direct transactional emails)
# If left empty, alerts are logged to local audit queue and sent via Google Apps Script MailApp
RESEND_API_KEY=

# 7. Optional WhatsApp Desk Helpline (Country code + digits without spaces, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# 8. Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Obtain from Google Analytics -> Admin -> Data Streams -> Web Stream
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 9. Google Search Console Verification Token
# Obtain from Google Search Console -> Settings -> Ownership Verification -> HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 10. Bing Webmaster Tools Verification Token
# Obtain from Bing Webmaster Tools -> Add Site -> HTML Meta Tag (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
