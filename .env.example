# =====================================================================
# BanglaCampus Environment Variables Specification
# =====================================================================
# Configure these in your local .env.local and in your Vercel Project Settings
# under Settings -> Environment Variables.

# 1. Base Site URL (For Vercel production: https://your-project.vercel.app or custom domain)
NEXT_PUBLIC_SITE_URL=https://banglacampus.in

# 2. Authentication Secret (32+ character random string for signing JWT sessions)
AUTH_SECRET=v9bK3x+M7wZ9Y0qJ6XpLt1u8R4FzQ2mK5hN3cT6vY1s=

# 3. Google OAuth 2.0 Credentials (From Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Google Sheets Integration Webhook (Google Apps Script Web App Deployment URL)
# Refer to GOOGLE_SHEETS_SETUP.md for complete 5-minute setup instructions
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# 5. Enquiry Alert Notification Email (Recipient for new student leads)
ENQUIRY_NOTIFICATION_EMAIL=hc8986234943@gmail.com

# 6. Optional Email Delivery Service (e.g. Resend for direct transactional emails)
# If left empty, alerts are logged to local audit queue and sent via Google Apps Script MailApp
RESEND_API_KEY=

# 7. Optional WhatsApp Desk Helpline (Country code + digits without spaces, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
