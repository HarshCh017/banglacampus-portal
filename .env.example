# =====================================================================
# BengalCampus — Environment Variables Specification
# =====================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Set these in your hosting provider (Vercel / Netlify / Cloudflare).

# Base Site URL
NEXT_PUBLIC_SITE_URL=https://bengalcampus.in

# Authentication Secret (32-byte secret)
AUTH_SECRET=replace_with_openssl_rand_base64_32_secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Sheets Integration Webhook (Single webhook for all forms)
# See GOOGLE_SHEETS_SETUP.md for complete deployment instructions
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Notification Email for New Leads
ENQUIRY_NOTIFICATION_EMAIL=admissions@bengalcampus.in

# Optional Transactional Email Delivery (Resend)
RESEND_API_KEY=

# Optional Student Helpline Desk
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics & Webmaster Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=googlef7ed5998c447340c
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional CRM Webhook
CRM_WEBHOOK_URL=
CRM_API_KEY=
